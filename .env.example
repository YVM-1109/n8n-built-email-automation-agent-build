# ============================================================
# Email Management Agent - Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# n8n Configuration
# ----------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=change_me_to_strong_password
N8N_ENCRYPTION_KEY=change_this_to_random_32_char_string
WEBHOOK_URL=http://localhost:5678

# ----------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=n8n

# ----------------------------------------------------------
# LLM APIs
# ----------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# Model routing
CLASSIFICATION_MODEL=gpt-4o-mini
DRAFTING_MODEL=gpt-4o
FALLBACK_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# Email Providers (IMAP)
# ----------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-gmail-app-password
IMAP_TLS=true

# ----------------------------------------------------------
# Slack Integration (optional)
# ----------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_ALERT_CHANNEL=#email-alerts

# ----------------------------------------------------------
# Notion Integration (optional)
# ----------------------------------------------------------
NOTION_API_KEY=secret_your_notion_key
NOTION_TASKS_DB=your-database-id

# ----------------------------------------------------------
# Qdrant (Vector DB)
# ----------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=email_embeddings

# ----------------------------------------------------------
# Monitoring (optional)
# ----------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_this_grafana_password

# ----------------------------------------------------------
# Agent Behavior
# ----------------------------------------------------------
AUTO_APPROVE_THRESHOLD=0.85
DEFAULT_TONE=professional
DEFAULT_RESPONSE_LENGTH=standard

# Feature flags
AUTO_REPLY_ENABLED=false
AUTO_ARCHIVE_NEWSLETTERS=true
SPAM_DETECTION_ENABLED=true
HUMAN_IN_LOOP_ENABLED=true

# ----------------------------------------------------------
# Timezone
# ----------------------------------------------------------
TZ=UTC
